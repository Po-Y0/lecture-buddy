# Development database. For Docker Compose, use the documented service URL.
DATABASE_URL=postgresql+psycopg://lecture_buddy:lecture_buddy@localhost:5432/lecture_buddy
WEB_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_SECONDS=1800
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=20971520

# Optional OpenAI-compatible AI provider configuration.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
MAX_AI_INPUT_CHARACTERS=60000

# Vite uses /api by default and proxies it to this backend during development.
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:8000
